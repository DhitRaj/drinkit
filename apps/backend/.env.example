NODE_ENV=development
PORT=3000
API_VERSION=v1
APP_ROLE=api

DATABASE_URL=postgresql://drinkit:drinkit@localhost:5432/drinkit?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:8081

AWS_REGION=ap-south-1
S3_PUBLIC_BUCKET=drinkit-public-assets
S3_PRIVATE_BUCKET=drinkit-secure-docs
